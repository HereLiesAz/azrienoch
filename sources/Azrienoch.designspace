<designspace format="5.0">
  <axes>
    <axis tag="wght" name="wght" minimum="100" maximum="900" default="400">
      <labelname xml:lang="en">Weight</labelname>
      <labels>
        <label uservalue="100" name="Thin"/>
        <label uservalue="400" name="Regular" elidable="true"/>
        <label uservalue="900" name="Black"/>
      </labels>
    </axis>
    <axis tag="wdth" name="wdth" minimum="75" maximum="100" default="100">
      <labelname xml:lang="en">Width</labelname>
      <labels>
        <label uservalue="75" name="Condensed"/>
        <label uservalue="100" name="Normal" elidable="true"/>
      </labels>
    </axis>
    <axis tag="SERF" name="SERF" minimum="0" maximum="100" default="0">
      <labelname xml:lang="en">Serif</labelname>
      <labels>
        <label uservalue="0" name="Sans" elidable="true"/>
        <label uservalue="100" name="Serif"/>
      </labels>
    </axis>
  </axes>
